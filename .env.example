# Release configuration reference only. Do not place real values in this file.
# Store secrets under GitHub > Settings > Environments > release > Environment secrets.

# Secret: Base64 content of the Developer ID Application .p12 certificate.
# Obtain the certificate from Apple Developer > Certificates, install it with its private key,
# then export it from macOS Keychain Access as a password-protected .p12 file.
# Encode on macOS with: base64 -i DeveloperIDApplication.p12 | tr -d '\n'
MAC_CSC_LINK=

# Secret: password chosen when exporting the Developer ID Application certificate as .p12.
MAC_CSC_KEY_PASSWORD=

# Secret: complete content, including BEGIN/END lines, of AuthKey_<KEY_ID>.p8.
# Obtain it once from App Store Connect > Users and Access > Integrations >
# App Store Connect API > Team Keys. Use the Developer role, not an Individual API Key.
APPLE_API_KEY=

# Secret: Key ID displayed beside the App Store Connect Team Key and in its .p8 filename.
APPLE_API_KEY_ID=

# Secret: Issuer ID displayed on App Store Connect > Users and Access > Integrations >
# App Store Connect API. This is not the Apple Team ID.
APPLE_API_ISSUER=
